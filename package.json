{
  "name": "quantum-ai-desktop",
  "version": "5.1.0",
  "description": "Quantum AI Lab - Nuclear Spaceship Edition - Desktop App",
  "main": "frontend/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "ai",
    "chatbot",
    "quantum",
    "electron",
    "desktop"
  ],
  "author": "Quantum AI Lab",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {},
  "build": {
    "appId": "com.quantumai.nuclear-spaceship",
    "productName": "Quantum AI Lab",
    "directories": {
      "output": "dist"
    },
    "files": [
      "frontend/**/*",
      "backend/**/*",
      "data/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  }
}
