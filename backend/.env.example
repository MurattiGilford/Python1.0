# Quantum AI Lab - API Keys Configuration
# Copy this file to .env and fill in your actual API keys

# ============================================================================
# REQUIRED API KEYS
# ============================================================================

# ZAI API (Required for GLM models and media generation)
# Get your key from: https://api.z.ai
ZAI_API_KEY=your_zai_api_key_here

# Moonshot AI API (Required for Kimi models)
# Get your key from: https://platform.moonshot.cn
MOONSHOT_API_KEY=your_moonshot_api_key_here

# ============================================================================
# OPTIONAL API KEYS
# ============================================================================

# News API (Optional - for real-time news)
# Get your key from: https://newsapi.org
NEWS_API_KEY=your_news_api_key_here

# OpenWeatherMap API (Optional - for real-time weather)
# Get your key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Stock API (Optional - for stock quotes)
# Examples: Alpha Vantage, Finnhub, etc.
STOCK_API_KEY=your_stock_api_key_here

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Server configuration
HOST=127.0.0.1
PORT=7861

# Environment (development, production)
ENVIRONMENT=development

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ============================================================================
# NOTES
# ============================================================================
#
# 1. Never commit your .env file to version control
# 2. Keep your API keys secure and rotate them regularly
# 3. Use environment-specific .env files for different deployments
# 4. Some features will use mock data if API keys are not configured
#
